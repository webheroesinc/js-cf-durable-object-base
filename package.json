{
  "name": "@whi/cf-do-base",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.typecheck.json",
    "build:test-fixture": "esbuild tests/fixtures/durable-object-test.ts --bundle --format=esm --outfile=tests/fixtures/dist/durable-object-test.js --external:node:* --external:cloudflare:*",
    "build:tests": "npm run build:test-fixture",
    "prebuild:tests": "npm run build",
    "pretest": "npm run build:tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "author": "Matthew Brisebois",
  "license": "LGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webheroesinc/js-cf-durable-object-base.git"
  },
  "homepage": "https://webheroesinc.github.io/js-cf-durable-object-base",
  "bugs": {
    "url": "https://github.com/webheroesinc/js-cf-durable-object-base/issues"
  },
  "description": "Base class for Cloudflare Durable Objects with built-in routing support",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "routing",
    "base-class"
  ],
  "dependencies": {
    "@whi/cf-routing": "^0.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "itty-router": "^5.0.18",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.50.0"
  }
}
